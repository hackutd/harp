# Portal (Vite) configuration.
#
#   cp .env.example .env.local
#
# Both variables are optional — the defaults work for standard local dev
# against a backend on :8080. Vite only exposes variables prefixed VITE_ to
# browser code; API_PROXY_TARGET is read by vite.config.ts at dev-server
# startup and never reaches the bundle.

# Shows the "Sign in with Google" button. Must be the string "true" to enable.
# This only controls the portal's UI — the backend gates Google OAuth
# separately via GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, so enable both or
# the button will render and then fail.
VITE_GOOGLE_AUTH_ENABLED=false

# Where the dev server proxies /v1/* and most /auth/* requests. Only used by
# `npm run dev`; production builds are served by the Go binary itself, so no
# proxy is involved.
API_PROXY_TARGET=http://localhost:8080
