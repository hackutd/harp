# Harp backend configuration.
#
#   cp .env.example .env
#
# Only four variables are strictly required (marked REQUIRED below) — the
# service refuses to start without them. Everything else has a working default
# for local development.
#
# Fastest way to a running stack with no third-party signups:
#
#   docker compose -f docker-compose.local-st.yml up -d
#
# That brings up PostgreSQL and a self-hosted SuperTokens, which covers
# DB_ADDR, SUPERTOKENS_CONNECTION_URI, and SUPERTOKENS_API_KEY. Then set
# AUTH_BASIC_USER / AUTH_BASIC_PASS below and you can boot.


# ── Core ─────────────────────────────────────────────────────────────────────

# "development" gives human-readable logs; anything else uses production JSON
# logging. Also gates dev-only behaviour.
ENV=development

# Port the Go service listens on.
ADDR=:8080

# Public URL of the API itself. SuperTokens builds its auth callbacks from
# this, so it must match how browsers actually reach the service.
APP_URL=http://localhost:8080

# Where the portal is served. Defaults to APP_URL, which is correct in
# production (the portal is compiled into the container and served from /),
# but in local dev Vite runs separately on 3000.
#
# This value is also the SuperTokens WebsiteDomain, which is why the portal is
# pinned to port 3000 and cannot casually be moved.
FRONTEND_URL=http://localhost:3000

# Shown in SuperTokens-generated emails and its dashboard.
APP_NAME=Harp Portal


# ── Database ─────────────────────────────────────────────────────────────────

# The default matches docker-compose.yml / docker-compose.local-st.yml.
# In production use your managed Postgres URL and drop sslmode=disable.
DB_ADDR=postgres://admin:adminpassword@localhost:5432/portal?sslmode=disable

DB_MAX_OPEN_CONNS=30
DB_MAX_IDLE_CONNS=30
DB_MAX_IDLE_TIME=15m


# ── Authentication (SuperTokens) ─────────────────────────────────────────────

# REQUIRED. Self-hosted core, or your managed SuperTokens instance.
# docker-compose.local-st.yml serves one at http://localhost:3567.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# REQUIRED. Must match the core's API key. The core rejects short keys, so use
# something long — docker-compose.local-st.yml uses a dev placeholder.
SUPERTOKENS_API_KEY=

# Optional: enables the "Sign in with Google" button. Leave both empty to run
# passwordless-only. If you set these, also set VITE_GOOGLE_AUTH_ENABLED=true
# in client/portal/.env — the backend and the portal are gated separately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Infrastructure endpoints (HTTP Basic auth) ───────────────────────────────

# REQUIRED. Guards /v1/health, /v1/debug/vars, and /v1/swagger/*.
# These are the only two variables with no sensible default — pick anything for
# local dev, but treat them as real credentials in production: /v1/debug/vars
# exposes runtime internals.
AUTH_BASIC_USER=admin
AUTH_BASIC_PASS=


# ── Public content API ───────────────────────────────────────────────────────

# Shared secret for /v1/public/{schedule,sponsors,faq}, checked as an
# X-API-Key header. These routes need no user session but are NOT
# unauthenticated. The marketing site (separate repo) sends this as
# HARP_PUBLIC_API_KEY — the two must match.
#
# Leave empty to disable the public routes entirely.
PUBLIC_API_KEY=

# Origin allowed to call /v1/public/* from a browser, e.g. your marketing
# site's domain. Empty means no browser origin is permitted; server-side
# fetches (what the marketing site actually does) are unaffected.
PUBLIC_CORS_ORIGIN=


# ── Email ────────────────────────────────────────────────────────────────────

# At least one provider is required or the service will not start: either
# SENDGRID_API_KEY, or the full SMTP set below. SendGrid wins if both are set.
SENDGRID_API_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Envelope sender. Must be an address your provider is authorised to send as.
EMAIL_FROM=noreply@example.com

# Display name on outgoing mail. Defaults to HACKATHON_NAME when unset.
EMAIL_FROM_NAME=


# ── Event identity ───────────────────────────────────────────────────────────

# Bootstrap value only. Once a super admin completes the onboarding form, the
# event name, from-address, and from-name are read from the database instead
# (see SetIdentityResolver in cmd/api/main.go) — so renaming the event never
# needs a redeploy, and editing this afterwards has no effect.
#
# It also seeds the per-cycle resume storage prefix in GCS
# (hackathons/<slug>/resumes/...), so it is worth setting correctly once.
HACKATHON_NAME=Hackathon


# ── File storage (Google Cloud Storage) ──────────────────────────────────────

# Leave empty for local development: the GCS client is skipped entirely and
# resume upload endpoints will not function. Set it in any real deployment.
GCS_BUCKET_NAME=

# Path to a service-account JSON key. Not needed on Cloud Run or GCE, where
# the attached service account is picked up automatically.
GOOGLE_APPLICATION_CREDENTIALS=


# ── Web push notifications ───────────────────────────────────────────────────

# Generate a keypair with:  task gen-vapid
# Leave empty to run without push. Rotating these invalidates every existing
# browser subscription, so generate once and keep them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address for push services, used if a provider needs to reach you.
VAPID_SUBJECT=noreply@example.com


# ── Rate limiting ────────────────────────────────────────────────────────────

RATE_LIMITER_ENABLED=true

# Requests per signed-in user per five-second window. Applies to /v1/* only.
RATELIMITER_REQUESTS_COUNT=20

# Requests per client IP per five-second window for /v1/* calls that do not
# carry a verified session (login page lookups, the first request after an
# access token expires). Larger than the per-user budget because every hacker
# at the venue typically shares one IP.
RATELIMITER_IP_REQUESTS_COUNT=200


# ── Apple Wallet passes (optional) ───────────────────────────────────────────

# Off by default. Turning this on requires a paid Apple Developer account and
# a Pass Type ID certificate; everything below is ignored while it is false.
APPLE_WALLET_ENABLED=false

APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_TEAM_IDENTIFIER=

# Shown on the pass itself. Both fall back to HACKATHON_NAME when left empty
# (organization name verbatim, description as "<name> Hacker Pass"), so most
# deployments never need to set them.
APPLE_WALLET_ORGANIZATION_NAME=
APPLE_WALLET_DESCRIPTION=

# Certificates as base64-encoded strings rather than file paths, so they can
# live in a secret manager alongside everything else.
APPLE_WALLET_CERTIFICATE_BASE64=
APPLE_WALLET_PRIVATE_KEY_BASE64=
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=

# Icon embedded in the pass. Resolved relative to the working directory.
APPLE_WALLET_ICON_PATH=client/portal/public/pwa-192x192.png
